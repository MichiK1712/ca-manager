# ============================================================
# CA-Manager — Umgebungsvariablen (in Portainer als Secrets/Env setzen)
# Werte NIE im Klartext ins Repo committen.
# ============================================================

# --- OIDC (Authentik, idp.mkubalek.eu) ---
OIDC_ISSUER=https://idp.mkubalek.eu/application/o/ca-manager/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://ca.kubalek.local/oidc/callback
OIDC_SCOPE=openid profile email

# --- CA intern ---
CFSSL_URL=http://cfssl:8888
UI_PORT=8080

# --- SMTP (externer Server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ca@kubalek.local
SMTP_TO=
SMTP_TLS=starttls        # starttls | ssl | none

# --- Renewal ---
RENEW_ENABLED=true
RENEW_DAYS_BEFORE=30

# --- Sicherheit ---
# Generiere z.B.: openssl rand -hex 32
SECRET_KEY=
# Passphrase für verschlüsselte CA-Private-Keys
CA_KEY_PASSPHRASE=
